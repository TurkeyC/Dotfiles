# ===== 配置终端 =====
#终端增强集成，默认为“detect”自动检测，这里显式指定 zsh
shell-integration = zsh
# 告诉 Shell 当前是 Ghostty 环境，然后再~/.zshrc检测到ghostty环境后会自动退出默认conda环境
env = GHOSTTY_TERM=1
#zsh启动，可以用`echo $SHELL`为bash和`ps -p $$`为zsh验证没有改变系统shell
command = /usr/bin/zsh -l


# ===== Ghostty 字体配置 =====

# ===== Ghostty 主题和颜色配置 =====
#指定Arcoiris主题
theme = Arcoiris
#光标颜色
cursor-color = FFFFFF
#光标的粗细
adjust-cursor-thickness = 2
#光标不透明度
cursor-opacity = 0.7
#选中文本的前景色
selection-foreground = 000000
#选中文本的背景色
selection-background = FFFFFF

# ===== Ghostty 鼠标和剪贴板配置 =====
#右键直接粘贴,当然,鼠标中键还是可以正常粘贴的
right-click-action = paste
#输入时隐藏鼠标
mouse-hide-while-typing = true
clipboard-read = allow
clipboard-write = allow
#粘贴时自动修剪末尾空格
clipboard-trim-trailing-spaces = true

# ===== Ghostty 窗口和界面配置 =====
#设置窗口client装饰栏
window-decoration = client
#初始窗口width
window-width = 128
#初始窗口height
window-height = 32
#终端的背景图
background-image = /mnt/g/Casuki_Fedora/documents/Gallary/Fedora/fedora-bbg-dark++nobg-1024.png
#背景图像的不透明度(0.3)
background-image-opacity = 0.01
#背景图像位置
background-image-position = bottom-right
#背景图像匹配
background-image-fit = contain
#背景不透明度(0.9)
background-opacity = 0.8
#未聚焦分割窗格的不透明度(0.7)
unfocused-split-opacity = 0.9
#未聚焦分割窗格的颜色
unfocused-split-fill = FFFFFF

# ===== Ghostty 终端行为配置 =====
#强制窗口标题始终使用该标题
title = "Ghostty"
#启用 URL 匹配
link-url = true

# ===== Ghostty 快捷键配置 =====
#有选区时复制，无选区时透传终止信号给 shell (保留ctrl+shift+c)
keybind = performable:ctrl+c=copy_to_clipboard
#Ctrl+V从剪切板粘贴 (保留ctrl+shift+v)
keybind = ctrl+v=paste_from_clipboard

# ===== Ghostty 其他设置 =====
#输入时自动清除选区（避免误操作）
selection-clear-on-typing = true
#复制后自动清除选区
selection-clear-on-copy = true

# --- Quick Terminal ---
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

keybind = global:alt+backquote=toggle_quick_terminal

